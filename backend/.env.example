# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local dev default (SQLite, zero setup). For Supabase Postgres use:
# postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./expensecast.db

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key: BACKEND ONLY. Never expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- ML model ---
MODEL_PATH=../machine-learning/models/lstm_expense_forecast.keras
SCALER_DIR=../machine-learning/scalers

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TMP_DIR=./tmp_uploads

# --- Demo mode ---
ENABLE_DEMO_MODE=true
DEMO_USER_ID=demo_user_001

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
